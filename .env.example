# Copy to .env and fill in. `.env` is git-ignored; never commit real keys.
# Every value is optional — the app runs with deterministic "quick mode"
# defaults when this file is absent.

# --- Live AI (optional) -------------------------------------------------
# Blank/missing => the agent runs in quick mode (no LLM calls at all).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local data ---------------------------------------------------------
# SQLite file. Relative paths resolve against the directory you launch
# uvicorn from. Omit to use the default data/campuspilot.db next to backend/.
# CAMPUSPILOT_DB=data/campuspilot.db

# Which seeded student the demo session uses. Must match
# ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$; defaults to student_demo.
DEMO_STUDENT_ID=student_demo

# --- Server -------------------------------------------------------------
PORT=8000
